{
  "name": "baby_timeline",
  "version": "1.0.0",
  "author": "ahntree",
  "license": "ISC",
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx --env-file-if-exists=.env --watch src/server/server.ts",
    "dev:client": "vite --config vite.config.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "pnpm run typecheck:client && vite build --config vite.config.ts",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "lint-staged": {
    "*.{cjs,css,graphql,html,js,json,jsx,md,mjs,scss,ts,tsx,vue,yaml,yml}": "prettier --write"
  }
}
