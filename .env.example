MEDIA_STORAGE_ROOT=/Volumes/YourExternalDrive/FamilyMedia

# Required: choose a private family passphrase with at least 12 characters.
# AUTH_PASSWORD=
# Required: generate a random secret with `openssl rand -hex 32`.
# COOKIE_SECRET=
# Set to true when the app is opened over HTTPS; keep false for local HTTP development.
COOKIE_SECURE=false

# Optional: set this when ffmpeg is not available on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
