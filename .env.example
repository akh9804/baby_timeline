MEDIA_STORAGE_ROOT=/Volumes/YourExternalDrive/FamilyMedia
DATABASE_PATH=data/family-media.db

# Read-only family passwords, each at least 6 characters.
# FAMILY_PASSWORDS=first-password,second-password
# Administrator accounts as a JSON array. Keep real passwords only in .env.
# ADMIN_ACCOUNTS_JSON='[{"username":"admin@example.com","password":"a-long-password"}]'
# Required: generate a random secret with `openssl rand -hex 32`.
# COOKIE_SECRET=
# Set to true when the app is opened over HTTPS; keep false for local HTTP development.
COOKIE_SECURE=false

# Optional: set this when ffmpeg is not available on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
